DJANGO_SECRET_KEY=replace-with-a-local-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=atlas_demo_demo
POSTGRES_USER=atlas_demo_app
POSTGRES_PASSWORD=replace-with-the-app-role-password
POSTGRES_SSLMODE=prefer

# Optional: pin tests to a known loaded customer.
# DJANGO_TEST_CUSTOMER_ID=1
